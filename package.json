{
  "name": "@lumeland/dom2",
  "description": "DOM & HTML parser in wasm",
  "author": {
    "name": "Óscar Otero"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run --no-isolate",
    "fmt": "oxfmt .",
    "build:wasm": "wasm-pack build --target bundler --out-dir=wasm --no-pack",
    "bench": "pnpm bench:internal && pnpm bench:compare",
    "bench:internal": "node --no-warnings=ExperimentalWarning bench/internal.ts",
    "bench:compare": "node --no-warnings=ExperimentalWarning bench/compare.ts",
    "lint": "oxlint . --fix"
  },
  "dependencies": {
    "css-select": "^7.0.0"
  },
  "devDependencies": {
    "@lumeland/dom": "^0.1.56",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/nwsapi": "^2.2.7",
    "jsdom": "^31.0.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "parse5": "^8.1.1",
    "tinybench": "^6.2.3",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0"
}
