{
  "name": "@lumeland/dom",
  "version": "1.0.0",
  "description": "DOM & HTML parser in wasm",
  "author": {
    "name": "Óscar Otero"
  },
  "files": [
    "build",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": "./mod.ts"
  },
  "scripts": {
    "test": "vitest run --no-isolate",
    "fmt": "oxfmt .",
    "build": "rm -rf package && pnpm build:wasm && tsc -p . && cp -r wasm build && pnpm pack --out=package.tgz && rm -rf build && tar -xzf package.tgz && rm package.tgz && node build.js && oxfmt package/*",
    "build:wasm": "wasm-pack build --target web --out-dir=wasm --no-pack",
    "bench": "pnpm bench:internal && pnpm bench:compare",
    "bench:internal": "node bench/internal.ts",
    "bench:compare": "node bench/compare.ts",
    "lint": "oxlint . --fix"
  },
  "dependencies": {
    "css-select": "^7.0.0"
  },
  "devDependencies": {
    "@b-fuze/deno-dom": "jsr:^0.1.56",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/nwsapi": "^2.2.7",
    "jsdom": "^31.0.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "parse5": "^8.1.1",
    "tinybench": "^6.2.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0"
}
